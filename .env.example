# Copy to .env.local for local testing; set the same variables in Vercel for production.
# Server-only: never prefix these with VITE_ (that would put them in the app bundle).
OPENAI_API_KEY=
# Crew members type this code once in the app's AI fill settings.
APP_ACCESS_CODE=
# Optional
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium
# ALLOWED_ORIGINS=https://your-other-domain.example

# Client: where the app sends AI requests. Default is same-origin /api/ai-edit.
# For the native app build, point it at your deployed site:
# VITE_AI_ENDPOINT=https://your-app.vercel.app/api/ai-edit
